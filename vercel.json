{
  "functions": {
    "api/parse.py": {
      "maxDuration": 30
    },
    "api/upload.py": {
      "maxDuration": 30
    },
    "api/images.py": {
      "maxDuration": 30
    },
    "api/tortikipirogi/parse.py": {
      "maxDuration": 30
    },
    "api/tortikipirogi/upload.py": {
      "maxDuration": 30
    },
    "api/tortikipirogi/images.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/style.css",
      "destination": "/web/style.css"
    },
    {
      "source": "/tortikipirogi",
      "destination": "/web/tortikipirogi.html"
    },
    {
      "source": "/tortikipirogi/",
      "destination": "/web/tortikipirogi.html"
    },
    {
      "source": "/tortikipirogi/app.js",
      "destination": "/web/app.js"
    },
    {
      "source": "/tortikipirogi/style.css",
      "destination": "/web/style.css"
    },
    {
      "source": "/tortikipirogi/(.*)",
      "destination": "/web/$1"
    }
  ]
}
